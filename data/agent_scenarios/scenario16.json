{
  "scenario_id": "SC-16",
  "scenario_name": "technique_id must always be valid MITRE format",
  "endpoint": "/decide",
  "rule": "See test descriptions \u2014 20 variations of the core rule",
  "langgraph_nodes_under_test": [
    "assess",
    "generate_mitre_plan",
    "select_tool",
    "risk_check"
  ],
  "test_count": 20,
  "tests": [
    {
      "id": "SC-16-T01",
      "description": "top=MQTT_BROKER(0.88) \u2014 technique must be T#### or T####.###",
      "input": {
        "recon": {
          "open_ports": {
            "1883": "MQTT",
            "4840": "OPC-UA"
          },
          "topic_count": 12
        },
        "vuln_scores": {
          "TXT_VGR": 0.9,
          "MQTT_BROKER": 0.7,
          "TXT_HBW": 0.6
        },
        "vuln_entries": [],
        "tools_available": [
          "AckSpoofTool_vgr",
          "VGRCommandInjector",
          "BrokerInfoProbeTool",
          "BrokerFloodTool",
          "FalseStateInjector_hbw"
        ],
        "history": [],
        "simulation_running": true,
        "campaign_plan": [],
        "current_round": 1
      },
      "expected_llm_outputs": {
        "generate_mitre_plan": {
          "technique_id_pattern": "^T\\d{4}(\\.\\d+)*$",
          "must_match_target_category": true,
          "note": "generate_mitre_plan must output a valid MITRE ATT&CK technique ID"
        },
        "select_tool": {
          "technique_id_pattern": "^T\\d{4}(\\.\\d+)*$",
          "note": "select_tool must also output a valid technique_id"
        }
      },
      "expected_final": {
        "technique_id_pattern": "^T\\d{4}(\\.\\d+)*$"
      }
    },
