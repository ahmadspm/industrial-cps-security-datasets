{
  "scenario_id": "SC-10",
  "scenario_name": "Poor repeated scores \u2192 pivot or replan",
  "endpoint": "/reflect",
  "rule": "See test descriptions \u2014 20 variations of the core rule",
  "langgraph_nodes_under_test": [
    "evaluate_outcome",
    "decide_continuation"
  ],
  "test_count": 20,
  "tests": [
    {
      "id": "SC-10-T01",
      "description": "3\u00d7 low scores [0.1, 0.12, 0.09], risk=0.2",
      "input": {
        "round_n": 4,
        "tool": "MessageReplayTool_hbw",
        "score": 0.08,
        "metrics": {
          "rate_score": 0.4,
          "silence_score": 0.6,
          "topic_score": 0.3,
          "error_msgs": 1
        },
        "history": [
          {
            "round": 1,
            "tool": "BrokerInfoProbeTool",
            "score": 0.12,
            "technique": "T0861",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.2
          },
          {
            "round": 2,
            "tool": "TopicHijackTool",
            "score": 0.09,
            "technique": "T0830",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.22
          },
          {
            "round": 3,
            "tool": "MessageReplayTool_hbw",
            "score": 0.08,
            "technique": "T0830",
            "target_node": "TXT_HBW",
            "detection_risk": 0.25
          }
        ],
        "campaign_plan": []
      },
      "expected_llm_outputs": {
        "evaluate_outcome": {
          "detection_risk": "~0.2",
          "outcome_summary_contains": [
            "plateau",
            "low score",
            "ineffective",
            "pivot",
            "replan"
          ]
        },
        "decide_continuation": {
          "campaign_decision": [
            "pivot",
            "replan"
          ],
          "stop_reason_not_empty": true,
          "note": "Hard guard: plateau=True \u2192 pivot before calling LLM"
        }
      },
      "expected_final": {
        "campaign_decision_in": [
          "pivot",
          "replan"
        ]
      }
    },
