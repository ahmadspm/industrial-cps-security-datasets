      "input": {
        "recon": {
          "open_ports": {
            "1883": "MQTT"
          },
          "topic_count": 8
        },
        "vuln_scores": {
          "MQTT_BROKER": 0.88,
          "TXT_HBW": 0.6
        },
        "vuln_entries": [],
        "tools_available": [
          "BrokerFloodTool",
          "ConnectionStormTool",
          "BrokerInfoProbeTool"
        ],
        "history": [
          {
            "round": 1,
            "tool": "BrokerFloodTool",
            "score": 0.4,
            "technique": "T1498",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.88
          },
          {
            "round": 2,
            "tool": "BrokerFloodTool",
            "score": 0.35,
            "technique": "T1498",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.91
          },
          {
            "round": 3,
            "tool": "ConnectionStormTool",
            "score": 0.3,
            "technique": "T1498",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.93
          }
        ],
        "simulation_running": true,
        "campaign_plan": [],
        "current_round": 4
      },
      "expected_llm_outputs": {
        "assess": {
          "next_action": "stop",
          "detection_risk": ">= 0.86",
          "note": "Hard guard: accumulated risk 0.86 > 0.85 \u2192 stop before LLM"
        }
      },
      "expected_final": {
        "stop": true,
        "source": "stop_decision"
      }
    },
