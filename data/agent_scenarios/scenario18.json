{
  "scenario_id": "SC-18",
  "scenario_name": "Recon endpoint returns structured factory analysis",
  "endpoint": "/recon",
  "rule": "See test descriptions \u2014 20 variations of the core rule",
  "langgraph_nodes_under_test": [
    "recon_llm"
  ],
  "test_count": 20,
  "tests": [
    {
      "id": "SC-18-T01",
      "description": "Recon with ports=[22, 80, 1883, 4840, 5432, 8501], topics=['f/i/state/vgr']",
      "input": {
        "prompt": "You are an elite ICS red team operator. Passive scan of a Fischertechnik Smart Factory:\n\nOpen ports: 1883 (MQTT), 4840 (OPC-UA)\nMQTT topics: f/i/state/hbw [32 msgs], f/i/state/vgr [28 msgs], f/i/stock [15 msgs], fl/vgr/ack [12 msgs]\nNo authentication on MQTT broker.\n\nFactory nodes: MQTT_BROKER, OpcuaServer, Historian, Dashboard, TXT_HBW, TXT_VGR, TXT_MPO\n\nRespond ONLY with valid JSON:\n{\n  \"reasoning_steps\": [\"...\"],\n  \"asset_assessment\": {\"MQTT_BROKER\": {\"vuln_score\": 0.0, \"justification\": \"...\", \"top_techniques\": [\"T...\"]}, \"TXT_HBW\": {\"vuln_score\": 0.0, \"justification\": \"...\", \"top_techniques\": [\"T...\"]}},\n  \"topology_insight\": \"...\",\n  \"priority_targets\": [{\"rank\": 1, \"node_id\": \"...\", \"reason\": \"...\", \"suggested_techniques\": [\"T...\"], \"tools\": [\"...\"], \"expected_impact\": \"...\"}],\n  \"attack_hypotheses\": [{\"entry_point\": \"...\", \"tool\": \"...\", \"hypothesis\": \"...\", \"operational_impact\": \"...\", \"detectability\": \"low\", \"stealth\": true}],\n  \"opening_move\": {\"tool\": \"BrokerInfoProbeTool\", \"rationale\": \"...\"}\n}"
      },
      "expected_llm_outputs": {
        "recon_llm": {
          "required_fields": [
            "priority_targets",
            "opening_move",
            "topology_insight",
            "reasoning_steps"
          ],
          "priority_targets_min_length": 1,
          "opening_move_has_tool": true,
          "topology_insight_not_empty": true,
          "note": "Recon LLM must return structured analysis grounded in topology"
        }
      },
      "expected_final": {
        "has_fields": [
          "priority_targets",
          "opening_move",
          "topology_insight"
        ],
        "priority_targets_is_list": true
      }
    },
