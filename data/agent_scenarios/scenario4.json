{
  "scenario_id": "SC-04",
  "scenario_name": "Loud tool swapped to stealth on high risk",
  "endpoint": "/decide",
  "rule": "See test descriptions \u2014 20 variations of the core rule",
  "langgraph_nodes_under_test": [
    "assess",
    "generate_mitre_plan",
    "select_tool",
    "risk_check"
  ],
  "test_count": 20,
  "tests": [
    {
      "id": "SC-04-T01",
      "description": "loud=BrokerFloodTool, stealth=BrokerInfoProbeTool, risk=0.72",
      "input": {
        "recon": {
          "open_ports": {
            "1883": "MQTT"
          },
          "topic_count": 10
        },
        "vuln_scores": {
          "MQTT_BROKER": 0.92,
          "TXT_HBW": 0.5
        },
        "vuln_entries": [],
        "tools_available": [
          "BrokerFloodTool",
          "BrokerInfoProbeTool"
        ],
        "history": [
          {
            "round": 1,
            "tool": "BrokerFloodTool",
            "score": 0.38,
            "technique": "T1498",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.89
          },
          {
            "round": 2,
            "tool": "BrokerFloodTool",
            "score": 0.34,
            "technique": "T1498",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.92
          },
          {
            "round": 3,
            "tool": "BrokerFloodTool",
            "score": 0.3,
            "technique": "T1498",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.94
          }
        ],
        "simulation_running": false,
        "campaign_plan": [],
        "current_round": 4
      },
      "expected_llm_outputs": {
        "assess": {
          "next_action": "attack",
          "detection_risk": "~0.72"
        },
        "generate_mitre_plan": {
          "target_node": "MQTT_BROKER",
          "technique_id_pattern": "^T\\d{4}(\\.\\d+)*$"
        },
        "select_tool": {
          "tool_must_not_be": "BrokerFloodTool"
        },
        "risk_check": {
          "action": "swap",
          "from": "BrokerFloodTool",
          "to_one_of": [
            "BrokerInfoProbeTool",
            "RetainedMessagePoisonTool",
            "TopicHijackTool"
          ],
          "note": "risk_check is deterministic Python \u2014 swaps loud\u2192stealth when risk>0.60"
        }
      },
      "expected_final": {
        "stop": false,
        "tool_not_in": [
          "OPCUAReadFloodTool",
          "BrokerFloodTool",
          "ConnectionStormTool"
        ]
      }
    },
