{
  "scenario_id": "SC-14",
  "scenario_name": "ReAct endpoint stops when detection risk is high",
  "endpoint": "/decide_react",
  "rule": "See test descriptions \u2014 20 variations of the core rule",
  "langgraph_nodes_under_test": [
    "_react_analyze_recon",
    "_run_react_loop"
  ],
  "test_count": 20,
  "tests": [
    {
      "id": "SC-14-T01",
      "description": "ReAct: 3 rounds with detection_risk=0.86",
      "input": {
        "recon": {
          "open_ports": {
            "1883": "MQTT"
          },
          "topic_count": 9
        },
        "vuln_scores": {
          "MQTT_BROKER": 0.88,
          "TXT_HBW": 0.58
        },
        "vuln_entries": [],
        "tools_available": [
          "BrokerFloodTool",
          "ConnectionStormTool",
          "BrokerInfoProbeTool"
        ],
        "history": [
          {
            "round": 1,
            "tool": "BrokerFloodTool",
            "score": 0.38,
            "technique": "T1498",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.91
          },
          {
            "round": 2,
            "tool": "BrokerFloodTool",
            "score": 0.33,
            "technique": "T1498",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.93
          },
          {
            "round": 3,
            "tool": "ConnectionStormTool",
            "score": 0.29,
            "technique": "T1498",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.95
          }
        ],
        "simulation_running": true,
        "campaign_plan": [],
        "current_round": 4
      },
      "expected_llm_outputs": {
        "_react_analyze_recon": {
          "next_action": "stop",
          "detection_risk": ">= 0.86",
          "note": "Hard guard in ReAct path: risk 0.86 > 0.85 \u2192 stop_decision"
        }
      },
      "expected_final": {
        "stop": true,
        "source": "stop_decision"
      }
    },
