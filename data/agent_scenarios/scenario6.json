{
  "scenario_id": "SC-06",
  "scenario_name": "Campaign plan overrides LLM planning",
  "endpoint": "/decide",
  "rule": "See test descriptions \u2014 20 variations of the core rule",
  "langgraph_nodes_under_test": [
    "assess",
    "generate_mitre_plan",
    "select_tool",
    "risk_check"
  ],
  "test_count": 20,
  "tests": [
    {
      "id": "SC-06-T01",
      "description": "plan specifies BrokerInfoProbeTool for round 1",
      "input": {
        "recon": {
          "open_ports": {
            "1883": "MQTT"
          },
          "topic_count": 12
        },
        "vuln_scores": {
          "MQTT_BROKER": 0.8,
          "TXT_HBW": 0.65
        },
        "vuln_entries": [],
        "tools_available": [
          "MessageReplayTool_hbw",
          "BrokerFloodTool",
          "BrokerInfoProbeTool"
        ],
        "history": [
          {
            "round": 1,
            "tool": "BrokerInfoProbeTool",
            "score": 0.55,
            "technique": "T0861",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.15
          }
        ],
        "simulation_running": true,
        "campaign_plan": [
          {
            "round": 2,
            "tool": "MessageReplayTool_hbw",
            "target": "TXT_HBW",
            "technique": "T0830",
            "purpose": "Replay stale HBW state messages to corrupt inventory tracking",
            "sets_up": "round 3",
            "contingency": "fall back to FalseStateInjector_hbw"
          }
        ],
        "current_round": 2
      },
      "expected_llm_outputs": {
        "assess": {
          "next_action": "use_plan",
          "note": "assess detects valid plan entry \u2192 returns use_plan without calling LLM planner"
        },
        "select_tool": {
          "tool_name": "BrokerInfoProbeTool",
          "note": "Plan tool must be selected \u2014 LLM override is skipped"
        }
      },
      "expected_final": {
        "stop": false,
        "tool": "BrokerInfoProbeTool"
      }
    },
