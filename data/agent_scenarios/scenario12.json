{
  "scenario_id": "SC-12",
  "scenario_name": "ReAct agent must reject hallucinated tool names",
  "endpoint": "/decide_react",
  "rule": "See test descriptions \u2014 20 variations of the core rule",
  "langgraph_nodes_under_test": [
    "_react_analyze_recon",
    "_run_react_loop"
  ],
  "test_count": 20,
  "tests": [
    {
      "id": "SC-12-T01",
      "description": "ReAct must not select 'GhostTool' \u2014 not in tools_available",
      "input": {
        "recon": {
          "open_ports": {
            "1883": "MQTT"
          },
          "topic_count": 8
        },
        "vuln_scores": {
          "MQTT_BROKER": 0.85,
          "TXT_HBW": 0.6
        },
        "vuln_entries": [],
        "tools_available": [
          "BrokerInfoProbeTool",
          "BrokerFloodTool"
        ],
        "history": [],
        "simulation_running": false,
        "campaign_plan": [],
        "current_round": 1
      },
      "expected_llm_outputs": {
        "_react_analyze_recon": {
          "next_action": "attack",
          "detection_risk": 0.0
        },
        "_run_react_loop": {
          "tool_must_be_in_or_empty": [
            "BrokerInfoProbeTool",
            "RetainedMessagePoisonTool",
            "TopicHijackTool",
            "ConnectionStormTool",
            "BrokerFloodTool",
            "OPCUAReadFloodTool"
          ],
          "must_not_select": "GhostTool",
          "note": "ReAct loop validates tool against tools_available after each LLM call"
        }
      },
      "expected_final": {
        "tool_in_available_or_empty": [
          "BrokerInfoProbeTool",
          "RetainedMessagePoisonTool",
          "TopicHijackTool",
          "ConnectionStormTool",
          "BrokerFloodTool",
          "OPCUAReadFloodTool"
        ],
        "tool_must_not_be": "GhostTool"
      }
    },
