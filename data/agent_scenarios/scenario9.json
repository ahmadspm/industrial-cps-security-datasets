{
  "scenario_id": "SC-09",
  "scenario_name": "Deep recon loop guard prevents infinite recursion",
  "endpoint": "/decide",
  "rule": "See test descriptions \u2014 20 variations of the core rule",
  "langgraph_nodes_under_test": [
    "assess",
    "generate_mitre_plan",
    "select_tool",
    "risk_check"
  ],
  "test_count": 20,
  "tests": [
    {
      "id": "SC-09-T01",
      "description": "deep_recon loop_count starts at 0, top=MQTT_BROKER",
      "input": {
        "recon": {
          "open_ports": {
            "1883": "MQTT"
          },
          "topic_count": 4
        },
        "vuln_scores": {
          "MQTT_BROKER": 0.51,
          "TXT_HBW": 0.5,
          "TXT_VGR": 0.49,
          "OpcuaServer": 0.48
        },
        "vuln_entries": [],
        "tools_available": [
          "BrokerInfoProbeTool",
          "BrokerFloodTool",
          "AckSpoofTool_vgr",
          "FalseStateInjector_hbw"
        ],
        "history": [],
        "simulation_running": true,
        "campaign_plan": [],
        "current_round": 1
      },
      "expected_llm_outputs": {
        "assess": {
          "next_action": [
            "attack",
            "deep_recon"
          ],
          "note": "May recon once, but must terminate"
        },
        "deep_recon": {
          "recommended_target": "any known topology node",
          "recommended_technique_pattern": "^T\\d{4}(\\.\\d+)*$",
          "note": "deep_recon enriches situation_analysis; loop_count incremented each pass"
        },
        "select_tool": {
          "tool_must_be_in": [
            "BrokerInfoProbeTool",
            "RetainedMessagePoisonTool",
            "TopicHijackTool",
            "ConnectionStormTool",
            "BrokerFloodTool",
            "OPCUAReadFloodTool"
          ]
        }
      },
      "expected_final": {
        "stop_or_tool_selected": true,
        "note": "Must not loop infinitely \u2014 graph recursion_limit=12 ensures termination"
      }
    },
