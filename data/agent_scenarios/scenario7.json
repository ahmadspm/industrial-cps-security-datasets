{
  "scenario_id": "SC-07",
  "scenario_name": "Planned tool unavailable \u2192 LLM fallback",
  "endpoint": "/decide",
  "rule": "See test descriptions \u2014 20 variations of the core rule",
  "langgraph_nodes_under_test": [
    "assess",
    "generate_mitre_plan",
    "select_tool",
    "risk_check"
  ],
  "test_count": 20,
  "tests": [
    {
      "id": "SC-07-T01",
      "description": "plan tool 'HypotheticalTool_X' not in tools_available \u2192 LLM fallback",
      "input": {
        "recon": {
          "open_ports": {
            "1883": "MQTT"
          },
          "topic_count": 12
        },
        "vuln_scores": {
          "MQTT_BROKER": 0.82,
          "TXT_HBW": 0.6
        },
        "vuln_entries": [],
        "tools_available": [
          "BrokerFloodTool",
          "BrokerInfoProbeTool"
        ],
        "history": [
          {
            "round": 1,
            "tool": "BrokerInfoProbeTool",
            "score": 0.52,
            "technique": "T0861",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.12
          }
        ],
        "simulation_running": false,
        "campaign_plan": [
          {
            "round": 2,
            "tool": "MessageReplayTool_hbw",
            "target": "TXT_HBW",
            "technique": "T0830",
            "purpose": "Replay HBW state messages"
          }
        ],
        "current_round": 2
      },
      "expected_llm_outputs": {
        "assess": {
          "next_action": "attack",
          "note": "Plan tool not available \u2192 assess falls through to normal LLM path"
        },
        "select_tool": {
          "tool_must_be_in": [
            "BrokerInfoProbeTool",
            "RetainedMessagePoisonTool",
            "TopicHijackTool",
            "ConnectionStormTool",
            "BrokerFloodTool",
            "OPCUAReadFloodTool"
          ],
          "tool_must_not_be": "HypotheticalTool_X",
          "note": "LLM must pick from tools_available, ignoring unavailable plan tool"
        }
      },
      "expected_final": {
        "stop": false,
        "tool_not_equal": "HypotheticalTool_X"
      }
    },
