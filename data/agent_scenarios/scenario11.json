  "tests": [
    {
      "id": "SC-11-T01",
      "description": "score=0.75>0.75, risk=0.15<0.25 \u2192 escalate/continue",
      "input": {
        "round_n": 3,
        "tool": "FalseStateInjector_hbw",
        "score": 0.75,
        "metrics": {
          "rate_score": 0.3,
          "silence_score": 0.8,
          "topic_score": 0.65,
          "error_msgs": 1
        },
        "history": [
          {
            "round": 1,
            "tool": "BrokerInfoProbeTool",
            "score": 0.52,
            "technique": "T0861",
            "target_node": "MQTT_BROKER",
            "detection_risk": 0.18
          },
          {
            "round": 2,
            "tool": "FalseStateInjector_hbw",
            "score": 0.65,
            "technique": "T0832",
            "target_node": "TXT_HBW",
            "detection_risk": 0.25
          }
        ],
        "campaign_plan": []
      },
      "expected_llm_outputs": {
        "evaluate_outcome": {
          "detection_risk": "~0.15",
          "outcome_summary_contains": [
            "success",
            "effective",
            "high score",
            "impact"
          ]
        },
        "decide_continuation": {
          "campaign_decision": [
            "escalate",
            "continue"
          ],
          "note": "High score + low risk \u2192 LLM should choose escalate or continue"
        }
      },
      "expected_final": {
        "campaign_decision_in": [
          "escalate",
          "continue"
        ]
      }
    },
