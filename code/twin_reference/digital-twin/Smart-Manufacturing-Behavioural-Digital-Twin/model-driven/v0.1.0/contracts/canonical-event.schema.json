{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/smart-factory-dt/event/1.0",
  "title": "Smart Factory Digital Twin Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "run_id",
    "source",
    "source_mode",
    "classification",
    "captured_at",
    "revision",
    "payload",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "smart-factory-dt.event/1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_mode": {
      "enum": ["physical_observation", "simulation", "replay", "test"]
    },
    "classification": {
      "enum": ["observed", "inferred", "simulated"]
    },
    "source_time": {"type": ["string", "null"], "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "simulation_time_s": {"type": ["number", "null"], "minimum": 0},
    "revision": {"type": "integer", "minimum": 0},
    "payload": {"type": "object"},
    "units": {"type": "object", "additionalProperties": {"type": "string"}},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "inference_rule": {"type": ["string", "null"]},
    "provenance": {"type": "object"}
  }
}

