<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_SmartFactory" targetNamespace="https://research.example/smart-factory-dt">
  <bpmn:process id="SmartFactoryProduction" name="Smart Factory Production Cycle" isExecutable="true">
    <bpmn:property id="reworkCount" name="reworkCount" itemSubjectRef="bpmn:tFormalExpression"/>
    <bpmn:property id="maxRework" name="maxRework" itemSubjectRef="bpmn:tFormalExpression"/>
    <bpmn:startEvent id="StartOrder" name="Production order received"/>
    <bpmn:serviceTask id="DSI_Detect" name="DSI detect and identify workpiece"/>
    <bpmn:serviceTask id="VGR_To_HBW" name="VGR transport workpiece to HBW"/>
    <bpmn:serviceTask id="HBW_Store" name="HBW store workpiece"/>
    <bpmn:serviceTask id="HBW_Fetch" name="HBW fetch workpiece for processing"/>
    <bpmn:serviceTask id="VGR_To_MPO" name="VGR transport workpiece to MPO"/>
    <bpmn:serviceTask id="MPO_Process" name="MPO burn, machine and eject workpiece"/>
    <bpmn:serviceTask id="VGR_To_SLD" name="VGR transport workpiece to SLD"/>
    <bpmn:serviceTask id="SLD_Sort" name="SLD detect colour and sort workpiece"/>
    <bpmn:exclusiveGateway id="QualityDecision" name="Quality disposition" default="Flow_ReworkDecision"/>
    <bpmn:exclusiveGateway id="ReworkLimit" name="Rework allowance available" default="Flow_Reject"/>
    <bpmn:serviceTask id="IncrementRework" name="Increment rework counter"/>
    <bpmn:serviceTask id="VGR_To_DSO" name="VGR transport accepted workpiece to DSO"/>
    <bpmn:serviceTask id="DSO_Complete" name="DSO complete production order"/>
    <bpmn:endEvent id="EndComplete" name="Order completed"/>
    <bpmn:endEvent id="EndRejected" name="Order rejected after bounded rework"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartOrder" targetRef="DSI_Detect"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="DSI_Detect" targetRef="VGR_To_HBW"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="VGR_To_HBW" targetRef="HBW_Store"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="HBW_Store" targetRef="HBW_Fetch"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="HBW_Fetch" targetRef="VGR_To_MPO"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="VGR_To_MPO" targetRef="MPO_Process"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="MPO_Process" targetRef="VGR_To_SLD"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="VGR_To_SLD" targetRef="SLD_Sort"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="SLD_Sort" targetRef="QualityDecision"/>
    <bpmn:sequenceFlow id="Flow_Accepted" name="accepted" sourceRef="QualityDecision" targetRef="VGR_To_DSO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">qualityStatus = 'accepted'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReworkDecision" name="rework or reject" sourceRef="QualityDecision" targetRef="ReworkLimit"/>
    <bpmn:sequenceFlow id="Flow_Rework" name="reworkCount less than maxRework" sourceRef="ReworkLimit" targetRef="IncrementRework">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reworkCount &lt; maxRework</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reprocess" sourceRef="IncrementRework" targetRef="VGR_To_MPO"/>
    <bpmn:sequenceFlow id="Flow_Reject" name="rework limit reached" sourceRef="ReworkLimit" targetRef="EndRejected"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="VGR_To_DSO" targetRef="DSO_Complete"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="DSO_Complete" targetRef="EndComplete"/>
  </bpmn:process>
</bpmn:definitions>

