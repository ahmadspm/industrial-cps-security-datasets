// Run from this directory with: omc run.mos
loadFile("TankPump.mo");
getErrorString();
checkModel(TankPump.ControllerChecks);
getErrorString();
simulate(TankPump.ControllerChecks, stopTime=11.1, numberOfIntervals=111, outputFormat="csv");
getErrorString();
checkModel(TankPump.Demonstrator);
simulate(TankPump.Demonstrator, stopTime=60, numberOfIntervals=600, tolerance=1e-8, outputFormat="csv");
getErrorString();
simulate(TankPump.BiasedSensor, stopTime=60, numberOfIntervals=600, tolerance=1e-8, outputFormat="csv");
getErrorString();
