-- CSP_M finite-state abstraction: each observation is one controller scan.
datatype Band = Low | Mid | High | Trip
datatype Mode = Off | Filling | Fault
channel observe : Band.Bool.Bool.Bool
channel command : Mode
channel passed

step(mode, band, enabled, fresh, reset) =
  if (not fresh) or band == Trip then Fault
  else if mode == Fault and (not reset) then Fault
  else if not enabled then Off
  else if band == Low then Filling
  else if band == High then Off
  else if mode == Fault then Off
  else mode

CTRL(mode) = observe?band?enabled?fresh?reset ->
             command!step(mode,band,enabled,fresh,reset) ->
             CTRL(step(mode,band,enabled,fresh,reset))

-- A safety envelope, intentionally less restrictive than the controller.
SAFETY = observe?band?enabled?fresh?reset ->
  (if (not fresh) or band == Trip then command.Fault -> SAFETY
   else if not enabled then
     (command.Off -> SAFETY [] command.Fault -> SAFETY)
   else command?mode -> SAFETY)

-- Fault output remains latched until a fresh, sub-trip reset observation.
LATCH_OK = observe?band?enabled?fresh?reset ->
          command?mode -> (if mode == Fault then FAULTED else LATCH_OK)
FAULTED = observe?band?enabled?fresh?reset ->
  (if fresh and band != Trip and reset then
      command?mode -> (if mode == Fault then FAULTED else LATCH_OK)
   else command.Fault -> FAULTED)

-- The shared 12-case sequence returns the controller to Off and repeats.
REPLAY = observe.Mid.true.true.false -> command.Off ->
         observe.Low.true.true.false -> command.Filling ->
         observe.Mid.true.true.false -> command.Filling ->
         observe.High.true.true.false -> command.Off ->
         observe.Low.false.true.false -> command.Off ->
         observe.Low.true.true.false -> command.Filling ->
         observe.Low.true.false.false -> command.Fault ->
         observe.Low.true.true.false -> command.Fault ->
         observe.Low.true.true.true -> command.Filling ->
         observe.Trip.true.true.false -> command.Fault ->
         observe.Trip.true.true.true -> command.Fault ->
         observe.Mid.true.true.true -> command.Off -> passed -> REPLAY

CHECK = (CTRL(Off) [| {|observe,command|} |] REPLAY) \ {|observe,command|}
assert CTRL(Off) :[deadlock free]
assert CTRL(Off) :[deterministic]
assert SAFETY [T= CTRL(Off)
assert LATCH_OK [T= CTRL(Off)
assert CHECK :[deadlock free]
